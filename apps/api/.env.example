# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
# Local Docker or local daemon: mongodb://<user>:<password>@localhost:27017/ktv_online?authSource=ktv_online
MONGODB_URI=mongodb://127.0.0.1:27017/ktv_online

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_dev
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# LiveKit Realtime Voice Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_WEBHOOK_SECRET=your_livekit_webhook_secret
