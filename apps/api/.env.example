# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
# KTVOnline requires database target 'test'.
# Standalone local Docker URI:
MONGODB_URI=mongodb://127.0.0.1:27017/test
# Local Replica Set URI (for multi-document ACID transactions under NODE_ENV=staging):
# MONGODB_URI=mongodb://127.0.0.1:27017/test?replicaSet=rs0
MONGODB_DB_NAME=test

# Authentication & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_dev
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
FRONTEND_URL=http://localhost:3000

# LiveKit Realtime Voice Configuration (Optional in dev, required in staging/production)
# LIVEKIT_URL: LiveKit Cloud or self-hosted WebSocket signaling URL (ws://, wss://)
LIVEKIT_URL=wss://your-staging-project.livekit.cloud
# LIVEKIT_API_KEY: LiveKit project API key
LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET: LiveKit project API secret
LIVEKIT_API_SECRET=secret
# LIVEKIT_WEBHOOK_SECRET: Optional webhook verification secret
LIVEKIT_WEBHOOK_SECRET=your_livekit_webhook_secret
